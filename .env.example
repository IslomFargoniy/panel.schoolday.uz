APP_NAME=SchoolDay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schollday
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Reverb WebSocket ──────────────────────────────────────────────────────────
# Generate unique values for production: php artisan reverb:install
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Hikvision ISUP Gateway ────────────────────────────────────────────────────
# Local C++ ISUP 5.0 daemon REST API URL (runs on the same server)
HIKVISION_GATEWAY_URL=http://127.0.0.1:7671
# Secret header value that the gateway daemon must send with every request.
# Set the same value in the gateway daemon config (X-Gateway-Secret: <value>).
HIKVISION_GATEWAY_SECRET=
# Trust requests from 127.0.0.1/::1 without the secret header. Set to false if a reverse proxy
# sits in front of the app (every client would then look like localhost).
HIKVISION_TRUST_LOCALHOST=true
# DAS (Device Access Server) address used by terminals to register via ISUP
HIKVISION_DAS_ADDRESS=193.180.213.188
# CMS port that terminals connect to (ISUP registration)
HIKVISION_CMS_PORT=7670
# Alarm callback port
HIKVISION_ALARM_PORT=7270
# HTTP request timeout in seconds for gateway API calls
HIKVISION_TIMEOUT=10
HIKVISION_NOTIFY_MAX_DELAY_MINUTES=10
# Default encryption/register key returned when a device has no explicit key.
# Leave empty to return 404 instead of a default key.
HIKVISION_DEFAULT_KEY=
# Shell command for self-healing daemon restart (null = disabled).
# Example for systemd: "systemctl restart hikvision-isup-schoolday"
HIKVISION_RESTART_COMMAND=

# ── Telegram ─────────────────────────────────────────────────────────────────
# Webhook secret token — must match the value set via TelegramService::setWebhook
TELEGRAM_WEBHOOK_SECRET=
# Optional Telegram bot for server-side error logging
TELEGRAM_LOG_BOT_TOKEN=
TELEGRAM_LOG_CHAT_ID=

# ── Seeder passwords (used ONCE when creating fresh users) ───────────────────
# If blank, a random password is generated and printed to console during seeding.
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=

TELESCOPE_ENABLED=false
